APP_ENV=dev
DATABASE_URL=sqlite:///./storage/database/datamind.db
UPLOAD_DIR=./storage/uploads
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_INPUT_PRICE_PER_1K=0
LLM_OUTPUT_PRICE_PER_1K=0
MAX_AGENT_STEPS=20
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT_SEC=30
RUN_TIMEOUT_SEC=300
MAX_UPLOAD_MB=50
DUCKDB_ENABLED=true
CORS_ORIGINS=http://localhost:3000
APP_API_KEY=
LARGE_FILE_MB=30
PROFILE_SAMPLE_ROWS=200000
LOG_DIR=./storage/logs
SETTINGS_PATH=./storage/settings.json
SQL_MAX_ROWS=5000
AGENT_ENGINE=langchain
AUTH_ENABLED=false
JWT_SECRET=dev-datamind-secret-change-me-32chars!!
JWT_EXPIRE_MIN=10080
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin
HTTP_URL_ALLOWLIST=https://httpbin.org/,https://api.github.com/
HTTP_MAX_RESPONSE_BYTES=65536
WEB_SEARCH_ENABLED=false
DB_CONNECT_TIMEOUT_SEC=8
CREDENTIAL_SECRET=dev-datamind-cred-key
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
CHROMA_PATH=./storage/chroma
KNOWLEDGE_DIR=./storage/knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
MCP_ENABLED=false
MCP_CONFIG_PATH=./storage/mcp_servers.json
MULTI_AGENT_ENABLED=true
CRITIC_ENABLED=false
WORKFLOW_MOCK_ANALYZE=true
WORKFLOW_TIMEOUT_SEC=600
MAX_DATASETS_PER_CONVERSATION=5
